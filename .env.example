# Copie para .env (cp .env.example .env) e troque pelos dados do seu MySQL/MariaDB
DB_HOST=localhost
DB_USER=root
DB_PASSW=sua_senha

# Segredo que assina o cookie de sessão (no mínimo 32 caracteres; cada máquina
# usa o seu e ele nunca vai para o git). Para gerar um:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opcionais (os valores abaixo são o padrão)
# DB_NAME=sistema_mural
# PORT=3000
# FRONTEND_URL=http://localhost:5173

# Produção (HTTPS): NODE_ENV=production exige o SESSION_SECRET e liga o cookie Secure.
# Atrás de proxy reverso (nginx), informe quantos proxies há na frente da API.
# NODE_ENV=production
# TRUST_PROXY=1
# COOKIE_SECURE=true
